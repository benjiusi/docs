{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BlankFX Docs",
  "description": "BlankFX documentation: get paid in any stablecoin. Swaps, payments, liquidity pools, RFQ for market makers, listing for stablecoin issuers, and the public API.",
  "colors": {
    "primary": "#4B9EFF",
    "light": "#4B9EFF",
    "dark": "#2D6BF0"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans",
      "weight": 700
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.blankfx.org"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "getting-started",
              "how-it-works"
            ]
          },
          {
            "group": "Using BlankFX",
            "pages": [
              "swaps",
              "earn",
              "agent-payments",
              "fees"
            ]
          },
          {
            "group": "Accept payments",
            "pages": [
              "pos"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "contracts",
              "tokens",
              "faq"
            ]
          },
          {
            "group": "Compliance & onboarding",
            "pages": [
              "compliance",
              "listing-requirements",
              "broker-mm-onboarding"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "api-reference/fx-flow",
              "api-reference/rfq-market-makers",
              "api-reference/transfers",
              "api-reference/x402",
              "api-reference/webhooks"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://blankfx.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to App",
      "href": "https://app.blankfx.org"
    }
  },
  "redirects": [
    {
      "source": "/tap",
      "destination": "/pos"
    }
  ]
}
